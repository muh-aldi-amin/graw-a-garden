body {
  margin: 0;
  font-family: "Poppins", sans-serif;
  background-color: #f3f9f3;
  color: #2f3e2f;
}

header {
  background-color: #5ca45c;
  color: white;
  padding: 1rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

nav a {
  color: white;
  margin: 0 10px;
  text-decoration: none;
  font-weight: bold;
}

nav a:hover {
  text-decoration: underline;
}

.hero {
  text-align: center;
  padding: 100px 20px;
  background: linear-gradient(135deg, #a8e6a2, #d0f0c0);
}

.hero button {
  background-color: #4e944f;
  border: none;
  padding: 10px 20px;
  border-radius: 10px;
  color: white;
  cursor: pointer;
  font-size: 1rem;
}

.hero button:hover {
  background-color: #417d41;
}

.content {
  padding: 50px 20px;
  text-align: center;
}

.bibit-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20px;
}

.card {
  background-color: #ffffff;
  border-radius: 15px;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
  width: 220px;
  padding: 15px;
  text-align: center;
  transition: 0.3s;
}

.card:hover {
  transform: scale(1.05);
}

.card img {
  width: 100%;
  border-radius: 10px;
}

form {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  max-width: 400px;
  margin: auto;
}

input, select, button {
  width: 100%;
  padding: 10px;
  border-radius: 10px;
  border: 1px solid #ccc;
}

button {
  background-color: #4e944f;
  color: white;
  cursor: pointer;
  border: none;
}

button:hover {
  background-color: #3a6f3a;
}

footer {
  text-align: center;
  padding: 20px;
  background-color: #5ca45c;
  color: white;
}
